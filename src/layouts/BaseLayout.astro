---
import '../styles/global.css';

const {
  title = 'KOORO Studio — Web Services',
  description = 'From locals to locals. KOORO Studio designs and builds editorial, practical websites for independent local businesses.'
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
