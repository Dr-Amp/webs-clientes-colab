---
import '../styles/global.css';

const { title = 'Webs bonitas para negocios locales', description = 'Demos visuales para negocios locales que quieren una web clara y cuidada.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
