---
import '../styles/global.css';

const {
  title = 'KOORO Studio — Sistemas web con pulso editorial',
  description = 'KOORO Studio diseña sistemas web editoriales para marcas y negocios con pulso propio: identidad, relato, interfaz y pequeños rituales digitales.'
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
