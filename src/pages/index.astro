---
import BaseLayout from '../layouts/BaseLayout.astro';

const ainoBase = '/aino/';
const quickLinks = [
  ['Base', '/aino/'],
  ['Webs', '/aino/work/'],
  ['Services', '/aino/services/'],
  ['Contact', '/aino/contact/'],
  ['Raw', '/landings/'],
];
---
<BaseLayout
  title="KOORO Studio — base KOORO para webs modernas"
  description="Banco de trabajo KOORO Studio: base KOORO navegable para convertir referencias raw en webs modernas, editoriales y coherentes."
>
  <main class="source-base-shell" aria-label="KOORO Studio — base KOORO para webs modernas">
    <div class="source-base-ribbon" aria-label="Navegación de la base KOORO">
      <a class="source-base-brand" href={ainoBase} target="aino-source" aria-label="Volver a la base KOORO">
        <strong>KOORO</strong>
        <span>Studio</span>
      </a>
      <nav aria-label="Rutas rápidas">
        {quickLinks.map(([label, href]) => <a href={href} target="aino-source">{label}</a>)}
      </nav>
      <p class="source-base-meta">KOORO source mount · no pátina</p>
    </div>
    <iframe
      class="source-base-frame"
      src={ainoBase}
      title="Source KOORO montado como base visual para KOORO Studio"
      name="aino-source"
      loading="eager"
    ></iframe>
  </main>
</BaseLayout>
