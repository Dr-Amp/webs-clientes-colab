---
import BaseLayout from '../layouts/BaseLayout.astro';

const ainoBase = '/aino/';
const quickLinks = [
  ['Work', '/aino/work/'],
  ['Services', '/aino/services/'],
  ['About', '/aino/about/'],
  ['Contact', '/aino/contact/'],
];
---
<BaseLayout
  title="KOORO Studio — Web Services"
  description="From locals to locals. KOORO Studio designs and builds editorial, practical websites for independent local businesses."
>
  <main class="source-base-shell" aria-label="KOORO Studio — Web Services">
    <div class="source-base-ribbon" aria-label="KOORO Studio navigation">
      <a class="source-base-brand" href={ainoBase} target="aino-source" aria-label="Volver a KOORO Studio">
        <strong>KOORO Studio</strong>
        <span>Web Services</span>
      </a>
      <nav aria-label="Rutas rápidas">
        {quickLinks.map(([label, href]) => <a href={href} target="aino-source">{label}</a>)}
      </nav>
      <p class="source-base-meta">From locals to locals</p>
    </div>
    <iframe
      class="source-base-frame"
      src={ainoBase}
      title="KOORO Studio source-style website"
      name="aino-source"
      loading="eager"
    ></iframe>
  </main>
</BaseLayout>
