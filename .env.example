# Plantilla pública de variables de entorno.
# Copiar a .env local si hace falta y rellenar fuera de git.
# No incluir credenciales reales en este archivo.

# Deploy: desactivado por defecto. No hay script FTP en el repo.
DEPLOY_ENABLED=false
DEPLOY_DRY_RUN=true

# Si se decide un hosting, definir variables nuevas en documentación aprobada.
# No añadir credenciales reales ni datos de proveedor a este archivo.

# Contacto / formularios futuros: placeholders, no credenciales.
CONTACT_EMAIL=contact@example.invalid
WHATSAPP_PHONE=000000000
